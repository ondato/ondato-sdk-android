<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.kyc.ondato</groupId>
  <artifactId>sdk</artifactId>
  <version>3.5.0</version>
  <packaging>pom</packaging>
  <name>Ondato SDK with Document Autocapture</name>
  <description>Convenience dependency that pulls sdk-core and document-autoresolver into one.</description>
  <dependencies>
    <dependency>
      <groupId>com.kyc.ondato</groupId>
      <artifactId>sdk-core</artifactId>
      <version>3.5.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.kyc.ondato</groupId>
      <artifactId>document-autoresolver</artifactId>
      <version>3.5.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
